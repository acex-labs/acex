FROM python:3.13-slim@sha256:d0a9e379c0c588befb0e427db17ca9731751d281f32c6cb1a90a1277b680bdad

WORKDIR /app

# Local dependencies (same pattern as backend/Dockerfile)
COPY devkit/ /deps/devkit/
COPY client/ /deps/client/
RUN pip install --no-cache-dir /deps/devkit /deps/client

COPY scripts/seed_mock_devices.py /app/

CMD ["python", "seed_mock_devices.py"]