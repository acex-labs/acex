ACEX_DB_PASSWORD=postgres
KEYCLOAK_ADMIN_PASSWORD=admin
ACEX_CREDENTIALS_ENCRYPTION_KEY=L50Zqr1VmsqTpbByFqXHJx1PIrp3ICZRGDf8Bo7pRh4=

INFLUXDB_PASSWORD=adminpassword
INFLUXDB_TOKEN=acex-dev-token

GRAFANA_PASSWORD=admin

ACEX_CREDENTIALS_VAULT_TOKEN=acex-vault-token
ACEX_AGENTS_SECRET=acex-agents-secret

# Path to the acex-frontend repo on your machine (relative to this directory)
FRONTEND_PATH=../acex-frontend

# SSH credentials for mock devices
MOCK_SSH_USERNAME=admin
MOCK_SSH_PASSWORD=admin

# Names of the collection and telemetry agents in ACEX (default: "default",
# as created by scripts/seed_mock_devices.py). The agents resolve their id
# from the name at startup.
COLLECTION_AGENT_NAME=
TELEMETRY_AGENT_NAME=
# Deprecated — still honoured when no *_AGENT_NAME is set
COLLECTION_AGENT_ID=
TELEMETRY_AGENT_ID=

# Bug reporting — optional, leave blank to disable
ACEX_BUG_REPORT_SLACK_WEBHOOK_URL=
ACEX_BUG_REPORT_ADO_SERVICE_PAT=
ACEX_BUG_REPORT_ADO_ORG=
ACEX_BUG_REPORT_ADO_PROJECT=
ACEX_BUG_REPORT_ADO_FEATURE_ID=

# RabbitMQ — optional, leave the host blank to disable
ACEX_RABBITMQ_HOST=
ACEX_RABBITMQ_PORT=5672
ACEX_RABBITMQ_VHOST=/
ACEX_RABBITMQ_USER=
ACEX_RABBITMQ_PASSWORD=
# TLS towards the broker (amqps://). The broker's certificate is always verified: against the system's roots, or
# ACEX_RABBITMQ_TLS_CA_FILE. A client certificate (mutual TLS) needs both files.
ACEX_RABBITMQ_TLS=false
ACEX_RABBITMQ_TLS_CA_FILE=
ACEX_RABBITMQ_TLS_CERT_FILE=
ACEX_RABBITMQ_TLS_KEY_FILE=
# What workers are handed when they reach the broker another way than the backend does. Blank: same as above.
ACEX_RABBITMQ_WORKER_HOST=
ACEX_RABBITMQ_WORKER_PORT=
ACEX_RABBITMQ_WORKER_TLS=
