{
  "realm": "acex",
  "enabled": true,
  "loginTheme": "keycloak",
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "acex-admin",
        "description": "Administrator of ACEX: may read the stored login of a device in the clear"
      },
      {
        "name": "acex-service",
        "description": "Agents and workers: fetch the stored logins of the devices they work on"
      }
    ]
  },
  "clients": [
    {
      "clientId": "acex",
      "name": "ACEX Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "*"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "acex-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "acex",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "acex-agents",
      "name": "ACEX Agents",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "acex-agents-secret",
      "protocolMappers": [
        {
          "name": "acex-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "acex",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@acex.local",
      "realmRoles": ["acex-admin"],
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-acex-agents",
      "enabled": true,
      "serviceAccountClientId": "acex-agents",
      "realmRoles": ["acex-service"]
    }
  ]
}
