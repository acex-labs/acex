    {
      "version": "6.23.0",
      "date": "2026-09-30",
      "entries": [
        {
          "title": "Fix/telemetry agent config flow",
          "description": null,
          "group": "Other",
          "breaking": false,
          "pr": 287,
          "commit": "2ea996f",
          "pr_url": "https://github.com/acex-labs/acex/pull/287",
          "commit_url": "https://github.com/acex-labs/acex/commit/2ea996fabddd39f2e30c01e88ed91c475417025c"
        },
        {
          "title": "Install devkit after poetry to ensure local version wins",
          "description": "poetry resolves acex-devkit from PyPI (2.8.0) as a transitive dep when\ninstalling acex-client, overwriting the pip install of /deps/devkit.\nMoving pip install /deps/devkit to after poetry install ensures the\nlocal source (2.9.0 with AgentNodeSet) is what ends up installed.",
          "group": "Fixed",
          "breaking": false,
          "pr": 290,
          "commit": "73cbbb2",
          "pr_url": "https://github.com/acex-labs/acex/pull/290",
          "commit_url": "https://github.com/acex-labs/acex/commit/73cbbb24279c701101c999fa29f70fa5c872e5cc"
        },
        {
          "title": "Split node status into admin_status and provision_status",
          "description": "Node.status is replaced by two fields:\n\n- admin_status: operator intent (planned | active | decommissioned).\n  The old \"init\" value is dropped in favour of provision_status.\n- provision_status: where the device is in the provisioning lifecycle\n  (unprovisioned | adopted | pending | bootstrapping | provisioning |\n  provisioned | failed). Set by the provisioning flow; \"adopted\" marks\n  brownfield devices brought under management.\n\nTelemetry and collection agent match rules get the same two fields.\nMCP tools, CLI, client example and csv_sync_nodes are updated; the CSV\nimport marks active devices as adopted.\n\nMigration c7d2e9f1a3b4 maps existing data: active -> adopted, others ->\nunprovisioned, init -> planned.",
          "group": "Added",
          "breaking": true,
          "pr": 292,
          "commit": "a268351",
          "pr_url": "https://github.com/acex-labs/acex/pull/292",
          "commit_url": "https://github.com/acex-labs/acex/commit/a268351b4b59605c712e5c2a1795c90060684265"
        }
      ]
    },
